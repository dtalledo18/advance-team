			<path d="M28.9472 17.4739H24.6781C24.0582 17.4739 23.5557 17.9765 23.5557 18.5964V22.8655C23.5557 23.4854 24.0582 23.9879 24.6781 23.9879H28.9472C29.5671 23.9879 30.0696 23.4854 30.0696 22.8655V18.5964C30.0696 17.9765 29.5671 17.4739 28.9472 17.4739Z"/>
			<path d="M21.0614 24.8461H16.7923C16.1724 24.8461 15.6699 25.3486 15.6699 25.9685V30.2376C15.6699 30.8575 16.1724 31.36 16.7923 31.36H21.0614C21.6813 31.36 22.1839 30.8575 22.1839 30.2376V25.9685C22.1839 25.3486 21.6813 24.8461 21.0614 24.8461Z"/>
			<path d="M28.9472 24.8461H24.6781C24.0582 24.8461 23.5557 25.3486 23.5557 25.9685V30.2376C23.5557 30.8575 24.0582 31.36 24.6781 31.36H28.9472C29.5671 31.36 30.0696 30.8575 30.0696 30.2376V25.9685C30.0696 25.3486 29.5671 24.8461 28.9472 24.8461Z"/>
			<path d="M2.23758 7.19031C1.09818 9.47152 0.327273 11.9709 0 14.6061L22.817 8.10909L45.7552 14.7055C45.4352 12.0388 44.6643 9.51273 43.5127 7.20728L22.9818 0L2.23758 7.19031Z"/>
		</svg>
	</a>
	<nav class="desktop-nav">
		<a href="#">Home</a>
		<a href="#about">About us</a>
		<a href="#services">Services</a>
		<a href="#contact">Contact</a>
	</nav>
</header>

<section class="scene-trigger">
	<div id="container-3d"></div>
	<section class="hero" id="hero">

		<div class="hero-content">
			<h1 class="hero-title">
				<span class="line"><span>WE'VE</span></span>
				<span class="line"><span>GOT YOU</span></span>
				<span class="line accent"><span>COVERED</span></span>
			</h1>
			<p class="hero-desc">
				From detailed inspections to full roof restoration, we handle every step
				with precision—working directly with your insurance to deliver fast,
				reliable, and <strong>long-term protection.</strong>
			</p>

			<!-- Botón FREE INSPECTION con gradiente -->
			<a href="#contact" class="hero-cta">Free Inspection</a>

			<!-- Contenedor de dots con label y nombres -->
			<div class="house-dots-container">
				<p class="house-dots-label">Explore what <em>we do best</em></p>
				<div class="house-dots">
					<div class="house-dot-wrap">
						<button class="house-dot active" data-view="roof" data-idx="0" title="Roof">
							<span class="dot-ring"></span>
						</button>
						<span class="dot-label">Roofing</span>
					</div>
					<div class="house-dot-wrap">
						<button class="house-dot" data-view="door" data-idx="1" title="Door">
							<span class="dot-ring"></span>
						</button>
						<span class="dot-label">Insurance</span>
					</div>
					<div class="house-dot-wrap">
						<button class="house-dot" data-view="aerial" data-idx="2" title="Aerial">
							<span class="dot-ring"></span>
						</button>
						<span class="dot-label">Construction</span>
					</div>
				</div>
			</div>

		</div>

		<div class="scroll-hint">Explore Divisions</div>
	</section>
</section>

<div class="marquee-section">
	<div class="marquee-track">
		<span class="marquee-item">Construction</span>
		<span class="marquee-item accent"> — </span>
		<span class="marquee-item">Roofing</span>
		<span class="marquee-item accent"> — </span>
		<span class="marquee-item">Insurance</span>
		<span class="marquee-item accent"> — </span>
		<span class="marquee-item">Management</span>
		<span class="marquee-item accent"> — </span>
		<span class="marquee-item">Service</span>
		<span class="marquee-item accent"> — </span>
		<span class="marquee-item">Construction</span>
		<span class="marquee-item accent"> — </span>
		<span class="marquee-item">Roofing</span>
		<span class="marquee-item accent"> — </span>
		<span class="marquee-item">Insurance</span>
		<span class="marquee-item accent"> — </span>
		<span class="marquee-item">Management</span>
		<span class="marquee-item accent"> — </span>
		<span class="marquee-item">Service</span>
		<span class="marquee-item accent"> — </span>
	</div>
</div>

<section class="about" id="about">
	<div class="about-left">
		<p class="about-label">About us</p>
		<h2 class="about-heading" id="about-heading">
			<span class="word"><span>One Parent</span></span><br />
			<span class="word"><span>company.</span></span><br />
			<span class="word accent"><span>Multiple</span></span>
			<span class="word accent"><span> elite</span></span><br />
			<span class="word accent"><span>divisions.</span></span>
		</h2>
		<div class="about-text">
			<p>From multiple counties to entire regions, our presence reflects where we’ve delivered results—bringing precision, reliability, and <strong>proven roofing solutions to every project we take on.</strong></p>
			<div class="about-stat">
				<div>
					<div class="stat-num" data-count="15">15+</div>
					<div class="stat-label">Years of Experience</div>
				</div>
				<div>
					<div class="stat-num" data-count="100">100%</div>
					<div class="stat-label">Happy Customers</div>
				</div>
				<div>
					<div class="stat-num" data-count="350">350+</div>
					<div class="stat-label">Projects Completed</div>
				</div>
			</div>
		</div>
	</div>

	<div class="about-right">
		<div class="about-img-stack">
			<img class="img-blueprint" src="/images/plano-tecnico.png" alt="Blueprint" />
			<div class="img-house-wrap">
				<img class="img-house" src="/images/casa-render.png" alt="House" />
