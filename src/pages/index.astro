		<span class="divisions-label">About us</span>
		<span class="divisions-label accent">Our divisions</span>
	</div>
	<ul class="divisions-list">
		<li class="division-item"><span class="division-name">Commercial</span><span class="division-num">01</span></li>
		<li class="division-item"><span class="division-name">Insurance</span><span class="division-num">02</span></li>
		<li class="division-item"><span class="division-name">Shingle</span><span class="division-num">03</span></li>
		<li class="division-item"><span class="division-name">Roofing</span><span class="division-num">04</span></li>
	</ul>
</section>

<section class="contact">
	<p class="contact-pre">Work With The Advanced</p>
	<h2 class="contact-heading">
		<span class="line"><span>Partner</span></span>
		<span class="line"><span>With AT</span></span>
	</h2>
	<a href="mailto:info@advancedteam.com" class="contact-cta"><span>info@advancedteam.com</span></a>
</section>

<footer>
	<div class="footer-logo">
		<img src="/images/advanced_logo.png" alt="Advanced Team" />
	</div>
	<div class="footer-info">
		<a href="tel:8156662286">(815) 666 2286</a>
		<a href="#">975 Rand Rd,</a>
		<a href="#">Des Plaines, IL 60016</a>
		<a href="mailto:admin@advancedteamelite.com">admin@advancedteamelite.com</a>
	</div>
	<div class="footer-copy">
		<p>© Copyright 2025 Advanced Team All Rights Reserved</p>
	</div>
</footer>

<script>
	import { initLenis } from '../scripts/lenis.js';
	import { initPreloader, initScrollAnimations } from '../scripts/animations.js';
	import { initFluid } from '../scripts/fluid.js';
	import { initScene3D } from '../scripts/scene3d.js';

	const lenis = initLenis();  // ← guardar la instancia (antes tenías solo initLenis())
	initPreloader();
	initScrollAnimations();
	initFluid();
	initScene3D();

	// Smooth nav con Lenis
	document.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"], a.logo').forEach(link => {
		link.addEventListener('click', (e) => {
			e.preventDefault();
			const href = link.getAttribute('href');
			if (!href || href === '#') {
				lenis.scrollTo(0, { duration: 1.8, easing: t => Math.min(1, 1.001 - Math.pow(2, -10 * t)) });
				return;
			}
			const target = document.querySelector(href);
			if (!target) return;
			lenis.scrollTo(target, { duration: 1.8, easing: t => Math.min(1, 1.001 - Math.pow(2, -10 * t)) });
		});
	});

	const aboutStack = document.querySelector('.about-img-stack');

	const stackObserver = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				const houseWrap = entry.target.querySelector('.img-house-wrap') as HTMLElement;
				// 1 segundo de delay → barrido de abajo hacia arriba (house aparece)
				setTimeout(() => {
					houseWrap.style.transition = 'clip-path 1.2s cubic-bezier(0.76, 0, 0.24, 1)';
					houseWrap.style.clipPath = 'inset(0% 0 0 0)';

					// Después de que aparece → espera y desvanece de abajo hacia arriba (house desaparece)
					setTimeout(() => {
						houseWrap.style.transition = 'clip-path 1.2s cubic-bezier(0.76, 0, 0.24, 1)';
						houseWrap.style.clipPath = 'inset(0% 0 100% 0)';
					}, 2400);

				}, 1000);

				stackObserver.unobserve(entry.target);
			}
		});
	}, { threshold: 0.4 });

	if (aboutStack) stackObserver.observe(aboutStack);

	// Puntos de la casa
	declare global {
		interface Window {
			__houseView: (view: string) => void;
			__setHousePoint: (idx: number) => void;
		}
	}

	const dots = document.querySelectorAll<HTMLButtonElement>('.house-dot');
	dots.forEach(dot => {
		dot.addEventListener('click', () => {
			const view    = dot.dataset.view as string;
			const isActive = dot.classList.contains('active');
			dots.forEach(d => d.classList.remove('active'));
			if (isActive) {
				window.__houseView?.('default');
				window.__setHousePoint?.(-1);
			} else {
				dot.classList.add('active');
				window.__houseView?.(view);
				window.__setHousePoint?.(parseInt(dot.dataset.idx as string));
			}
		});
	});
</script>

<script is:inline>
	(function() {
		const WIDGET_URL = "https://roofing-quote-two.vercel.app/widget?accent=ffa501&text=000000";
		const ACCENT     = "#ffa501";
		const LABEL      = "Free Roof Quote";

		const css = `
        #rq-tab {
            position: fixed; 
            right: 0; 
            top: 50%;
            /* Usamos translateX(0) como base para la animación */
            transform: translateY(-50%) rotate(180deg) translateX(0);
            z-index: 1000000; 
            background: ${ACCENT}; color: #000;
            writing-mode: vertical-rl; text-orientation: mixed;
            padding: 20px 10px; border-radius: 0 20px 20px 0;
            font-family: system-ui, sans-serif; font-size: 16px;
            font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;
            cursor: pointer; border: none;
            box-shadow: -4px 0 20px rgba(0,0,0,0.2);
            display: flex; align-items: center; gap: 10px;
            /* Usamos exactamente la misma transición que el panel */
            transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1), 
				background 0.3s ease, 
				box-shadow 0.3s ease,
				padding 0.25s ease;
    		will-change: transform;
            user-select: none;
        }
        
        #rq-tab.rq-open {
            /* En lugar de cambiar 'right', lo empujamos hacia la izquierda con transform */
            /* El valor es positivo porque el elemento está rotado 180deg */
            transform: translateY(-50%) rotate(180deg) translateX(660px);
        }

        @media (max-width: 660px) {
            #rq-tab.rq-open { 
                transform: translateY(-50%) rotate(180deg) translateX(calc(100vw - 40px)); 
            }
        }

        #rq-panel-wrap {
            position: fixed; top: 0; right: 0; height: 100%;
            width: 660px; max-width: 100vw; z-index: 99999;
            transform: translateX(100%);
            transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
            display: flex; flex-direction: column;
            background: white; box-shadow: -8px 0 40px rgba(0,0,0,0.18);
            will-change: transform;
        }

        #rq-tab:hover { padding: 20px 14px; box-shadow: -6px 0 28px rgba(0,0,0,0.28); }
        #rq-tab svg { transform: rotate(90deg); flex-shrink: 0; }
        
        #rq-overlay {
            position: fixed; inset: 0; background: rgba(0,0,0,0.4);
            z-index: 99998; opacity: 0; pointer-events: none;
            transition: opacity 0.3s ease; backdrop-filter: blur(2px);
        }
        #rq-overlay.rq-open { opacity: 1; pointer-events: all; }
       
        #rq-panel-wrap.rq-open { transform: translateX(0); }
        #rq-panel-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 16px 20px; background: ${ACCENT}; color: #000;
            font-family: system-ui, sans-serif; flex-shrink: 0;
        }
        #rq-panel-header span { font-size: 15px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; }
        #rq-close-btn {
            background: rgba(0,0,0,0.1); border: none; color: #000;
            width: 32px; height: 32px; border-radius: 50%; cursor: pointer;
            font-size: 18px; display: flex; align-items: center; justify-content: center;
            transition: background 0.15s; line-height: 1;
        }
        #rq-close-btn:hover { background: rgba(0,0,0,0.2); }
        #rq-iframe { flex: 1; border: none; width: 100%; }
        `;

		const style = document.createElement("style");
		style.textContent = css;
		document.head.appendChild(style);

		const tab = document.createElement("button");
		tab.id = "rq-tab";
		tab.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><polyline points="9 21 9 12 15 12 15 21"/></svg>${LABEL}`;

		const overlay = document.createElement("div"); overlay.id = "rq-overlay";
		const panelWrap = document.createElement("div"); panelWrap.id = "rq-panel-wrap";
		const panelHeader = document.createElement("div"); panelHeader.id = "rq-panel-header";
		panelHeader.innerHTML = `<span>${LABEL}</span><button id="rq-close-btn" aria-label="Close">✕</button>`;
		const iframe = document.createElement("iframe");
		iframe.id = "rq-iframe"; iframe.src = WIDGET_URL; iframe.setAttribute("title", "Roofing Quote");

		panelWrap.appendChild(panelHeader);
		panelWrap.appendChild(iframe);
		document.body.appendChild(overlay);
		document.body.appendChild(panelWrap);
		document.body.appendChild(tab);

		let isOpen = false;
		function open()  {
			isOpen=true;
			panelWrap.classList.add("rq-open");
			overlay.classList.add("rq-open");
			tab.classList.add("rq-open"); // Añadimos clase al tab para moverlo
		}
		function close() {
			isOpen=false;
			panelWrap.classList.remove("rq-open");
			overlay.classList.remove("rq-open");
			tab.classList.remove("rq-open"); // Quitamos clase para que regrese al borde derecho
		}

		tab.addEventListener("click", () => { if(!isOpen) open(); else close(); });
		overlay.addEventListener("click", close);
		document.getElementById("rq-panel-header").querySelector("#rq-close-btn").addEventListener("click", close);
		document.addEventListener("keydown", (e) => { if (e.key === "Escape" && isOpen) close(); });
	})();
</script>

</body>
</html>