---
// MapSection.astro
import illinoisRaw from '../images/usa-il.svg?raw';
---

<section class="outer-container">
    <div class="map-card">
        <div id="details-box"></div>

        <div class="card-content">
            <div class="info-side">
                <div class="search-container">
                    <input type="text" placeholder="Search your location" id="map-search" />
                    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </div>

                <div class="text-content">
                    <p class="label">Counties</p>
                    <h2 class="title">ADVANCED <br><span class="highlight">IS HERE</span></h2>
                    <p class="description">
                        From multiple counties to entire regions, our presence reflects where we’ve delivered results—bringing precision, reliability, and <strong>proven roofing solutions to every project we take on.</strong>
                    </p>
                </div>
            </div>

            <div class="map-side">
                <div id="map-wrapper" set:html={illinoisRaw} />
            </div>
        </div>
    </div>
</section>

<style is:global>
    .outer-container {
        padding: 40px 20px;
        background-color: #f0f0f2;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        font-family: 'Inter', sans-serif;
    }

    .map-card {
        background-color: #e2e2e4;
        background-image: radial-gradient(circle at center, #e8e8ea 0%, #e2e2e4 100%);
        width: 100%;
        max-width: 1200px;
        /* Fijamos un alto para la tarjeta para que el mapa tenga una referencia */
        height: 650px;
        border-radius: 32px;
        padding: 60px 80px;
        position: relative;
        box-shadow: 0 25px 50px rgba(0,0,0,0.06);
        display: flex;
        flex-direction: column;
    }

    .card-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 100%; /* Ocupa todo el alto interno de la card */
        gap: 40px;
    }

    .info-side {
        flex: 0 0 400px;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between; /* Separa search de texto como el mockup */
        padding: 20px 0;
    }

    /* BARRA DE BÚSQUEDA */
    .search-container {
        position: relative; /* Clave para posicionar el icono dentro */
        width: 100%;
        max-width: 320px;
    }

    #map-search {
        width: 100%;
        padding: 14px 24px;
        padding-right: 50px; /* Espacio para que el texto no choque con el icono */
        border-radius: 50px;
        border: none;
        background: white;
        font-size: 15px;
        color: #333;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        outline: none;
    }

    #map-search::placeholder {
        color: #aaa;
    }

    .search-icon {
        position: absolute;
        right: 20px; /* Distancia desde el borde derecho */
        top: 50%;
        transform: translateY(-50%); /* Centrado vertical perfecto */
        color: #333;
        pointer-events: none; /* El icono no interfiere con el click en el input */
    }

    /* TEXTO */
    .title {
        font-size: 64px;
        font-weight: 900;
        line-height: 0.9;
        color: #1a1a1a;
        margin-bottom: 25px;
    }

    .highlight { color: #FFAF01; }

    /* EL MAPA: LA SOLUCIÓN AL "FIT HEIGHT" */
    .map-side {
        flex: 1;
        height: 100%; /* Forzamos a que el contenedor del mapa use el alto de la card */
        display: flex;
        justify-content: flex-end; /* Alinea a la derecha como el mockup */
        align-items: center;
        overflow: hidden;
        margin: auto;
    }

    .description{
        line-height: 1.5;
        font-family: 'DM Sans', sans-serif;
    }

    #map-wrapper {
        height: 110%; /* Lo hacemos un poco más grande que el contenedor para "llenar" */
        display: flex;
        align-items: center;
    }

    #map-wrapper svg {
        height: 95%;
        width: auto;
    }

    #map-wrapper path {
        fill: #E6D9D9 !important;
        stroke: #ffffff !important;
        stroke-width: 0.2px; /* Más fino para mayor escala */
        transition: all 0.3s ease;
        cursor: pointer;
        vector-effect: non-scaling-stroke;
    }

    #map-wrapper path:hover {
        fill: #FFAF01 !important;
    }

    /* TOOLTIP */
    #details-box {
        opacity: 0;
        padding: 16px 22px;
        border-radius: 14px;
        position: fixed;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.12);
        pointer-events: none;
        z-index: 1000;
        border: 1px solid white;
    }
</style>

<script>
    const detailsBox = document.getElementById('details-box');
    const mapWrapper = document.getElementById('map-wrapper');

    if (mapWrapper && detailsBox) {
        const svg = mapWrapper.querySelector('svg');
        if (svg) {
            svg.addEventListener('mouseover', (e) => {
                const target = e.target as SVGPathElement;
                if (target.tagName === 'path') {
                    const projects = target.getAttribute('data-projects') || "72";
                    detailsBox.innerHTML = `
                        <div style="font-weight: 900; font-size: 28px; line-height: 1; color: #000;">${projects}</div>
                        <div style="font-size: 12px; color: #555; font-weight: 600; margin-top: 4px;">Projects Completed</div>
                    `;
                    detailsBox.style.opacity = "1";
                }
            });

            svg.addEventListener('mouseout', () => detailsBox.style.opacity = "0");

            window.addEventListener('mousemove', (e) => {
                detailsBox.style.top = `${e.clientY - 90}px`;
                detailsBox.style.left = `${e.clientX + 25}px`;
            });
        }
    }
</script>