---
// MapSection.astro
import illinoisRaw from '../images/usa-il.svg?raw';
---

<section class="outer-container">
    <div class="services-header">
        <span class="section-label">Our Structure</span>
        <span class="section-label">(05 divisions)</span>
    </div>
    <div class="map-card">
        <div id="details-box"></div>

        <div class="card-content">
            <div class="info-side">
                <div class="search-container">
                    <input type="text" placeholder="Search your location" id="map-search" />
                    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </div>

                <div class="text-content">
                    <p class="label">Counties</p>
                    <h2 class="title">ADVANCED <br><span class="highlight">IS HERE</span></h2>
                    <p class="description">
                        From multiple counties to entire regions, our presence reflects where we’ve delivered results—bringing precision, reliability, and <strong>proven roofing solutions to every project we take on.</strong>
                    </p>
                </div>
            </div>

            <div class="map-side">
                <div id="map-wrapper" set:html={illinoisRaw} />
            </div>
        </div>
    </div>
</section>

<style is:global>
    .outer-container {
        padding: 0 20px;
        background: rgba(214,214,221,0.95);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        font-family: 'Inter', sans-serif;
    }
    .services-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 80px; }
    .section-label { font-size: 10px; letter-spacing: .4em; text-transform: uppercase; color: var(--muted); }

    .map-card {
        background-color: #e2e2e4;
        background-image: radial-gradient(circle at center, #e8e8ea 0%, #e2e2e4 100%);
        width: 100%;
        max-width: 1200px;
        /* Fijamos un alto para la tarjeta para que el mapa tenga una referencia */
        height: 650px;
        border-radius: 32px;
        padding: 60px 80px;
        position: relative;
        box-shadow: 0 25px 50px rgba(0,0,0,0.06);
        display: flex;
        flex-direction: column;
    }

    .card-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 100%; /* Ocupa todo el alto interno de la card */
        gap: 40px;
    }

    .info-side {
        flex: 0 0 400px;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between; /* Separa search de texto como el mockup */
        padding: 20px 0;
    }

    /* BARRA DE BÚSQUEDA */
    .search-container {
        position: relative; /* Clave para posicionar el icono dentro */
        width: 100%;
        max-width: 320px;
    }

    #map-search {
        width: 100%;
        padding: 14px 24px;
        padding-right: 50px; /* Espacio para que el texto no choque con el icono */
        border-radius: 50px;
        border: none;
        background: white;
        font-size: 15px;
        color: #333;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        outline: none;
    }

    #map-search::placeholder {
        color: #aaa;
    }

    .search-icon {
        position: absolute;
        right: 20px; /* Distancia desde el borde derecho */
        top: 50%;
        transform: translateY(-50%); /* Centrado vertical perfecto */
        color: #333;
        pointer-events: none; /* El icono no interfiere con el click en el input */
    }

    /* TEXTO */
    .title {
        font-size: 64px;
        font-weight: 900;
        line-height: 0.9;
        color: #1a1a1a;
        margin-bottom: 25px;
    }

    .highlight { color: #FFAF01; }

    /* EL MAPA: LA SOLUCIÓN AL "FIT HEIGHT" */
    .map-side {
        flex: 1;
        height: 100%; /* Forzamos a que el contenedor del mapa use el alto de la card */
        display: flex;
        justify-content: flex-end; /* Alinea a la derecha como el mockup */
        align-items: center;
        overflow: hidden;
        margin: auto;
    }

    .description{
        line-height: 1.5;
        font-family: 'DM Sans', sans-serif;
    }

    #map-wrapper {
        height: 110%; /* Lo hacemos un poco más grande que el contenedor para "llenar" */
        display: flex;
        align-items: center;
    }

    #map-wrapper svg {
        height: 95%;
        width: auto;
    }

    #map-wrapper,
    #map-wrapper svg {
        pointer-events: auto !important;
    }

    #map-wrapper path {
        fill: #E6D9D9 !important;
        stroke: #ffffff !important;
        stroke-width: 0.2px; /* Más fino para mayor escala */
        transition: all 0.3s ease;
        cursor: pointer;
        vector-effect: non-scaling-stroke;
    }

    #map-wrapper path:hover {
        fill: #FFAF01 !important;
    }

    /* TOOLTIP */
    #details-box {
        opacity: 0;
        padding: 16px 22px;
        border-radius: 14px;
        position: fixed;
        background: rgba(255, 255, 255, 0.15); /* Muy transparente */
        backdrop-filter: blur(12px) saturate(180%); /* El desenfoque clave */
        -webkit-backdrop-filter: blur(12px) saturate(180%);
        box-shadow: 0 15px 35px rgba(0,0,0,0.12);
        pointer-events: none;
        z-index: 1000;
        border: 1px solid rgba(255, 255, 255, 0.26);
        font-family: 'Inter', sans-serif;
    }
</style>

<script>
    const countyData = {
        "Cook": 7827,
        "Kankakee": 1070,
        "DuPage": 964,
        "Will": 836,
        "McHenry": 602,
        "Lake": 468,
        "Livingston": 435,
        "Kane": 368,
        "Madison": 67,
        "McLean": 100,
        "Vermilion": 84,
        "Iroquois": 42,
        "Alexander": 12,
        "Pulaski": 8,
        "Massac": 15,
        "Hardin": 5,
        "Pope": 9,
        "Johnson": 18,
        "Union": 22,
        "Gallatin": 7,
        "Saline": 31,
        "Williamson": 115,
        "Jackson": 98,
        "Monroe": 54,
        "Randolph": 41,
        "Perry": 33,
        "Franklin": 76,
        "Hamilton": 14,
        "White": 19,
        "Jefferson": 102,
        "Washington": 28,
        "Clinton": 45,
        "St._Clair": 312,
        "Bond": 24,
        "Marion": 63,
        "Wayne": 16,
        "Wabash": 12,
        "Edwards": 9,
        "Lawrence": 21,
        "Richland": 26,
        "Clay": 18,
        "Jasper": 15,
        "Crawford": 22,
        "Clark": 19,
        "Cumberland": 14,
        "Effingham": 88,
        "Fayette": 31,
        "Shelby": 38,
        "Montgomery": 42,
        "Jersey": 29,
        "Macoupin": 56,
        "Calhoun": 7,
        "Greene": 18,
        "Christian": 64,
        "Coles": 92,
        "Edgar": 24,
        "Douglas": 36,
        "Moultrie": 21,
        "Macon": 184
    };

    // Seleccionamos los elementos
    const detailsBox = document.getElementById('details-box');
    const mapWrapper = document.getElementById('map-wrapper');

    // Aseguramos que existan
    if (mapWrapper && detailsBox) {
        // Escuchamos el evento mouseover sobre el contenedor del mapa
        mapWrapper.addEventListener('mouseover', function (e) {
            // Obtenemos el path exacto que activó el evento
            const target = e.target as SVGPathElement;

            // Verificamos que sea un 'path' y no el fondo del SVG
            if (target.tagName === 'path') {
                // 1. Obtenemos el nombre del ID (ej: "Cook" o "St._Clair")
                const countyId = target.id;

                // 2. Buscamos en nuestro objeto.
                // Si no existe, generamos un número coherente (entre 5 y 25) para "rellenar"
                let projects = countyData[countyId];

                if (projects === undefined) {
                    // Opcional: Inventar data para los condados que faltan
                    // Para que no se vea "0" en los 107 condados
                    projects = Math.floor(Math.random() * (25 - 5 + 1)) + 5;
                }

                // 3. Limpiamos el nombre para mostrar (quitamos guiones bajos si existen)
                const displayName = countyId.replace(/_/g, ' ');

                // 4. Inyectamos la data formateada
                detailsBox.innerHTML = `
                    <div style="font-weight: 800; font-size: 24px; color: #000;">${projects.toLocaleString()}</div>
                    <div style="font-size: 11px; color: #292929; font-weight: 600; text-transform: uppercase;">
                        Projects in ${displayName}
                    </div>
                `;

                detailsBox.style.opacity = "1";
            }
        });

        // Ocultamos el tooltip al salir de un path
        mapWrapper.addEventListener('mouseout', function (e) {
            const target = e.target as SVGPathElement;
            if (target.tagName === 'path') {
                detailsBox.style.opacity = "0";
            }
        });

        // Movemos el tooltip con el mouse
        window.addEventListener('mousemove', function (e) {
            const x = e.clientX;
            const y = e.clientY;

            // Posicionamos el tooltip un poco arriba y a la derecha del cursor (como el mockup)
            // Ajusta los valores -80 y +20 según tus necesidades de espaciado
            detailsBox.style.top = (y - 80) + 'px';
            detailsBox.style.left = (x + 20) + 'px';
        });
    }
</script>